{
  "Routes": [
    {
      "DownstreamPathTemplate": "/api/Auth/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7276
        }
      ],
      "UpstreamPathTemplate": "/api/Auth/{everything}",
      "UpstreamHttpMethod": [ "POST" ],
      "RateLimitOptions": {
        "EnableRateLimiting": true,
        "Period": "60s",
        "PeriodTimespan": 30,
        "Limit": 10
      }
    },
    {
      "DownstreamPathTemplate": "/api/product/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7006
        }
      ],
      "UpstreamPathTemplate": "/api/product/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer"
      },
      "AddHeadersToRequest": {
        "X-TenantId": "Claims[TenantId] > value",
        "X-UserId": "Claims[UserId] > value"
      },
      "RateLimitOptions": {
        "EnableRateLimiting": true,
        "Period": "30s",
        "PeriodTimespan": 30,
        "Limit": 10
      },
      "QoSOptions": {
        "ExceptionsAllowedBeforeBreaking": 3,
        "DurationOfBreak": 30000,
        "TimeoutValue": 10000
      }
    },
    {
      "DownstreamPathTemplate": "/api/product/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7006
        }
      ],
      "UpstreamPathTemplate": "/product/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer"
      },
      "AddHeadersToRequest": {
        "X-TenantId": "Claims[TenantId] > value",
        "X-UserId": "Claims[UserId] > value"
      },
      "RateLimitOptions": {
        "EnableRateLimiting": true,
        "Period": "30s",
        "PeriodTimespan": 30,
        "Limit": 10
      }
    },
    {
      "DownstreamPathTemplate": "/api/Stock/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7147
        }
      ],
      "UpstreamPathTemplate": "/api/Stock/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer"
      },
      "AddHeadersToRequest": {
        "X-TenantId": "Claims[TenantId] > value",
        "X-UserId": "Claims[UserId] > value"
      },
      "RateLimitOptions": {
        "EnableRateLimiting": true,
        "Period": "30s",
        "PeriodTimespan": 30,
        "Limit": 15
      }

    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "https://localhost:7000",
    "RateLimitOptions": {
      "ClientIdHeader": "ClientId",
      "QuotaExceededMessage": "Too many requests. Please try again later.",
      "HttpStatusCode": 429,
      "DisableRateLimitHeaders": false
    }
  }
}